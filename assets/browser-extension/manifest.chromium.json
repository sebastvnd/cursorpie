{
  "manifest_version": 3,
  "name": "CursorPie Bridge",
  "description": "Tells the CursorPie app on this computer which web pages are open, so its Open URL slice can go to a page that is already open. Nothing leaves your computer.",
  "version": "{{VERSION}}",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js" }
}
