{
  "manifest_version": 3,
  "name": "CursorPie Bridge",
  "description": "Lets the CursorPie app on this computer control the browser: go to a page that is already open, play/pause/next on players, switch and close tabs, and move around WhatsApp Web and Telegram Web. Nothing leaves your computer.",
  "version": "{{VERSION}}",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms",
    "scripting",
    "storage",
    "sessions"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://open.spotify.com/*",
    "https://soundcloud.com/*",
    "https://music.apple.com/*",
    "https://*.deezer.com/*",
    "https://*.tidal.com/*",
    "https://*.bandcamp.com/*",
    "https://*.twitch.tv/*",
    "https://vimeo.com/*",
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.dailymotion.com/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  }
}
